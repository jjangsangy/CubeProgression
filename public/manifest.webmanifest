{
  "name": "CubeProgression",
  "short_name": "CubeProgression",
  "description": "Upload csTimer session logs to analyze solve time progression, moving averages, daily variance, distribution density shifts, and consistency metrics.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "protocol_handlers": [
    {
      "protocol": "web+cubeprogression",
      "url": "./?url=%s"
    }
  ],
  "background_color": "#0c0a09",
  "theme_color": "#0c0a09",
  "orientation": "any",
  "categories": ["sports", "utilities", "productivity"],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "./manifest.webmanifest",
      "id": "./"
    }
  ],
  "shortcuts": [
    {
      "name": "Solve Progression",
      "short_name": "Progression",
      "description": "Analyze solve times, moving averages, and progression trends",
      "url": "./#progression-chart",
      "icons": [
        {
          "src": "./favicon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        },
        {
          "src": "./pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "PB Progression",
      "short_name": "Personal Bests",
      "description": "View historical PB progression milestones and record splits",
      "url": "./#deferred-pb-progression",
      "icons": [
        {
          "src": "./favicon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        },
        {
          "src": "./pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Distribution & Density",
      "short_name": "Density Shift",
      "description": "Compare baseline versus recent solve time distribution density",
      "url": "./#deferred-density-shift",
      "icons": [
        {
          "src": "./favicon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        },
        {
          "src": "./pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Solves History",
      "short_name": "Solves Table",
      "description": "Browse and search through all recorded solves in active session",
      "url": "./#deferred-solves-table",
      "icons": [
        {
          "src": "./favicon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        },
        {
          "src": "./pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
